# Build output is committed on purpose (the .json is the deliverable),
# but local WordPress artifacts and binaries are not.
node_modules/
*.log
.DS_Store
Thumbs.db

# LocalWP / WordPress site files -- never commit a whole WP install
wp-content/
wp-config.php
*.sql
*.sql.gz

# Screenshots are heavy; keep only the curated ones under assets/
assets/raw/

# ZIP gerado por build/pack-theme.ps1 -- artefato derivado, nao versionado
dist/

# Saida bruta do Simply Static: 64MB de wp-includes que a pagina nao usa.
# A versao enxuta fica em site-dist/, gerada por build/prune-static.mjs
site/

# Excecao: o site-dist/ e o artefato publicavel e precisa dos assets.
# Sao 20 arquivos e 0,4MB, nao uma instalacao WordPress.
!site-dist/
!site-dist/**
